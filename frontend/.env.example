# Copy this file to .env for local testing (no AWS needed):
#   cp .env.example .env
#
# The app already auto-detects "running on localhost" and points at
# 127.0.0.1:8000 with no .env at all — these defaults just make that
# explicit, so a fresh `cp .env.example .env` still works locally rather
# than silently pointing at the AWS deployment below.

VITE_WS_URL=ws://127.0.0.1:8000/ws
VITE_API_URL=http://127.0.0.1:8000
VITE_DEVICE_ID=rpi-1

# ── To point at the real AWS/EC2 deployment instead ──────────────────────────
# VITE_WS_URL=ws://43.205.167.81/ws
# VITE_API_URL=http://43.205.167.81
