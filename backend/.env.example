# Backend configuration (EC2). Copy to .env and edit, or paste into the
# systemd unit as Environment= lines.

# ── Storage ────────────────────────────────────────────────────────────────
# false = fall events kept in memory only (fine for a demo; lost on restart)
# true  = also written to DynamoDB (needs an IAM role or credentials)
USE_DYNAMODB=false
AWS_REGION=ap-south-1
RADAR_EVENTS_TABLE=radar_events

# ── Fall detection (tuned on real recordings 16 Sep; change only if needed) ──
FALL_METHOD=velocity
FALL_DESCENT_SPEED=0.5          # m/s, opens a possible fall
FALL_MIN_PEAK_SPEED=0.7         # m/s, fastest descent needed to confirm
FALL_MAX_HEAD_RATIO=0.70        # head must end below 70% of standing height
FALL_MIN_HEAD_DROP=0.4          # m, minimum head drop
FALL_MIN_TRACK_AGE=20           # frames a person must be tracked before judging
FALL_CONFIRM_FRAMES=18          # ~1 s down before alerting
FALL_REBOUND_SPEED=0.25         # m/s upward that cancels a possible fall
FALL_COOLDOWN_FRAMES=90         # ~5 s pause after a confirmed fall
FALL_MAX_HORIZONTAL_SPEED=0.5   # m/s, ignore drops while moving fast
SENSOR_ELEV_TILT_DEG=15         # must match the radar's mounting tilt
