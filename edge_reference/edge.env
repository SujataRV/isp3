# ── Edge configuration (Raspberry Pi) ───────────────────────────────────────
# Everything the two edge programs need. Edit this file only.

# Where the AWS backend lives. Change the IP/host after deploying to EC2.
# Keep the /frame suffix: the watcher derives /frames/batch and
# /activity/pointcloud/batch from this base.
export CLOUD_API_URL="http://43.205.167.81/frame"

# Name this radar unit. The dashboard subscribes per device id.
export DEVICE_ID="rpi-1"

# Seconds to wait for the cloud API before giving up on one batch.
export CLOUD_TIMEOUT="3.0"

# Folder the visualizer streams JSON into and the watcher tails.
export WATCH_DIR="$HOME/radar_edge/visualizer/radar_stream"

# Radar chirp config (the one the models were trained and validated on).
export RADAR_CFG="$HOME/radar_edge/visualizer/AOP_6m_default.cfg"

# Uploads are gzip-compressed and coordinates trimmed to millimetres: about
# 26 KB per second of radar instead of 284 KB. Set GZIP_UPLOAD=false only if
# you are talking to an older backend that cannot unpack it (the watcher
# retries uncompressed by itself anyway).
export GZIP_UPLOAD="true"
export UPLOAD_ROUND_DP="3"
